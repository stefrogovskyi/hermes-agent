# Copy to .env and fill real values. .env is gitignored — never commit it.

# SINGLE bot token (from BotFather). This is the ONLY token for this agent.
# If you pasted it in chat, revoke+reissue in BotFather afterward.
TELEGRAM_BOT_TOKEN=

# Owner chat id for escalations/digests (Stefan). Get via @userinfobot.
STEFAN_CHAT_ID=

# Mention handle without '@' (used by the agent to detect @mentions).
BOT_USERNAME=richnavobot

# OPTIONAL: restrict to one group. OMIT (leave empty) to read ANY group the bot is in.
GROUP_CHAT_ID=

# OPTIONAL: comma-separated on-domain trigger keywords.
ON_DOMAIN_KEYWORDS=логистика,фрахт,navo,трекинг,ставки,груз,контейнер,морской,букинг,freight,shipping,tracking,rate,shipment,port,customs,charter,trackingmcp,schedulesmcp,loadingmcp,freightratesmcp
